<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The bar along the top of Home shows whether Wi-Fi is connected. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GPS speed decides whether the car on the home screen is driving or standing still. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- Reads the car's data from a paired OBD-II adapter. Android 12+ asks for the run-time permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <!-- Records trips while another app is on screen: a foreground service that listens to the GPS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updates: hands the downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <!-- Cars may be driven by rotary controllers instead of touch. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- The packages: for the diagnostics screen. HOME: to see which Home app is active. LAUNCHER: every app with an
         icon, for All apps; without it Android 11+ hides most apps from the list, even from the default Home app. -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">

            <!-- Without this the system blocks the launcher while the car is moving. The UI has no text input. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <!-- Makes the app selectable as the car's Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Lets Android Studio / adb start it like a normal app during development. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Maps on Home; the key comes from the build (see app/build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <service
            android:name=".sync.TripRecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
